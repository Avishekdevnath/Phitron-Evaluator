{
  "manifest_version": 3,
  "name": "Phitron Assignment Evaluator",
  "version": "0.1.0",
  "description": "AI-powered assignment evaluator for educators",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "sidePanel",
    "clipboardRead",
    "downloads"
  ],
  "action": {
    "default_title": "Phitron Evaluator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "*://phitron.io/instructor-dashboard/my-assignment*",
    "*://colab.research.google.com/*",
    "*://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://phitron.io/instructor-dashboard/my-assignment*",
        "*://colab.research.google.com/*",
        "*://docs.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://phitron.io/instructor-dashboard/my-assignment*"],
      "js": ["phitronContent.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://colab.research.google.com/*"],
      "js": ["colabBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://docs.google.com/*"],
      "js": ["docsBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
